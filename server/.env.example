# Server Port and Host
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/droppilot?schema=public"

# Auth and Security
AUTH_SECRET="super-secret-auth-key-change-this-in-production-min-32-chars-long"
AUTH_URL="http://localhost:5000"
PLATFORM_ROOT_DOMAIN="localhost"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Frontend Origin for CORS
CLIENT_ORIGIN="http://localhost:3000"

# Redis & Background Workers
REDIS_URL="redis://localhost:6379"

# Object Storage / S3 / Cloudinary
OBJECT_STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
OBJECT_STORAGE_BUCKET="droppilot-assets"
OBJECT_STORAGE_ACCESS_KEY="mock-access-key"
OBJECT_STORAGE_SECRET_KEY="mock-secret-key"

# Email Provider
EMAIL_FROM="no-reply@droppilot.com"
EMAIL_API_KEY="mock-resend-or-sendgrid-api-key"

# SaaS Subscription Billing (Razorpay)
RAZORPAY_KEY_ID="rzp_test_mock_saas_key"
RAZORPAY_KEY_SECRET="mock_saas_secret"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_key"

# Supplier Integration (AliExpress / CJ / Sandbox)
SUPPLIER_API_BASE_URL="https://api-sg.aliexpress.com/sync"
SUPPLIER_CLIENT_ID="mock_supplier_client_id"
SUPPLIER_CLIENT_SECRET="mock_supplier_client_secret"
